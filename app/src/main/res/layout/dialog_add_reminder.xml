<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Reminder"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3C1E6D"
        android:layout_marginBottom="20dp" />

    <!-- Title Field -->
    <EditText
        android:id="@+id/etReminderTitle"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Title"
        android:textSize="14sp"
        android:textColorHint="#999999"
        android:textColor="#333333"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Date Field (Clickable) -->
    <LinearLayout
        android:id="@+id/llDatePicker"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 "
            android:textSize="16sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvReminderDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Date"
            android:textSize="14sp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textSize="12sp"
            android:textColor="#999999" />

    </LinearLayout>

    <!-- Note Field -->
    <EditText
        android:id="@+id/etReminderNote"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Note (optional)"
        android:textSize="14sp"
        android:textColorHint="#999999"
        android:textColor="#333333"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:background="@drawable/button_cancel_darker"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Add Reminder"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_rounded"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>