<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Software Engineering Intern"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3C1E6D"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Mountain View, CA"
                android:textSize="14sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- Description Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 About this Opportunity"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3C1E6D"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This internship offers an opportunity to work on cutting-edge technology..."
                android:textSize="14sp"
                android:textColor="#444444"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Application Status Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 Application Status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3C1E6D"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <RadioGroup
                android:id="@+id/radioGroupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioInterested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interested"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioButton
                    android:id="@+id/radioApplied"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applied"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioButton
                    android:id="@+id/radioInterview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interview"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioButton
                    android:id="@+id/radioAccepted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accepted"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioButton
                    android:id="@+id/radioRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rejected"
                    android:textSize="14sp" />

            </RadioGroup>

        </LinearLayout>

        <!-- Save Status Button -->
        <Button
            android:id="@+id/btnSaveStatus"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SAVE STATUS"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_rounded" />

    </LinearLayout>

</ScrollView>